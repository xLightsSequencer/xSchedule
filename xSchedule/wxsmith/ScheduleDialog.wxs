					<handler function="OnTextCtrl_SkipDatesText" entry="EVT_TEXT" />
				</object>
				<flag>wxALL|wxEXPAND</flag>
				<border>5</border>
				<option>1</option>
			</object>
			<object class="sizeritem">
				<object class="wxStaticText" name="ID_STATICTEXT_SECTIONTIMES" variable="StaticText_SectionTimes" member="yes">

						<object class="wxCheckBox" name="ID_CHECKBOX4" variable="CheckBox_Fri" member="yes">
							<handler function="OnCheckBox_DOWClick" entry="EVT_CHECKBOX" />
						</object>
						<flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
						<border>5</border>

  <!-- Stage the prebuilt Windows dependencies (wxWidgets, FFmpeg, curl, SDL2, zstd, zlib) from the
       xLights-dependencies bundle pinned by xlights\ci_scripts\deps_version.txt, using the
       xLights submodule's own fetch script. It skips the download when already staged. -->
  <Target Name="FetchDependencies" BeforeTargets="ClCompile" Condition="'$(Platform)'=='x64'">
    <Message Importance="high" Text="Staging prebuilt dependencies..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\xlights\ci_scripts\fetch_dependencies.ps1&quot; -Only Dependencies" />
  </Target>

<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="RemoteFalcon" />
		<Option execution_dir="../../bin/" />
		<Option pch_mode="0" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Linux_Debug">
				<Option platforms="Unix;" />
				<Option output="../../bin/RemoteFalcon" imp_lib="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).a" def_file="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).def" prefix_auto="1" extension_auto="1" />
				<Option object_output=".objs_ld" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Option projectCompilerOptionsRelation="1" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-g" />
					<Add option="-fPIC" />
					<Add option="-std=gnu++20" />
					<Add option="`wx-config --version=3.3 --cflags`" />
					<Add option="`pkg-config --cflags libavformat libavcodec libavutil  libswresample libswscale`" />
					<Add option="`pkg-config --cflags gstreamer-1.0 gstreamer-video-1.0`" />
					<Add option="`curl-config --cflags`" />
					<Add option="-Winvalid-pch" />
					<Add option="-DWX_PRECOMP" />
					<Add option="-DLINUX" />
					<Add option="-D__WXDEBUG__" />
					<Add option='-D__cdecl=&quot;&quot;' />
					<Add directory="include" />
					<Add directory="../xSchedule/RemoteFalcon" />
					<Add directory="../include" />
					<Add directory="../../xLights" />
					<Add directory="../../xlights/src-core" />
					<Add directory="../../xlights/src-core/utils" />
					<Add directory="../../xlights/src-core/render" />
					<Add directory="../../xlights/src-ui-wx" />
					<Add directory="../../xlights/src-ui-wx/shared/utils" />
					<Add directory="../../xlights/common" />
					<Add directory="../../xlights/include" />
					<Add directory="../../dependencies/pugixml/src" />
					<Add directory="../../dependencies/spdlog/include" />
				</Compiler>
				<Linker>
					<Add option="-lGL -lGLU -lglut -ldl -lX11 -lz -lzstd" />
					<Add option="`pkg-config --libs libavformat libavcodec libavutil  libswresample libswscale`" />
					<Add option="`sdl2-config --libs`" />
					<Add option="`wx-config --version=3.3 --libs std,media,gl,aui,propgrid`" />
					<Add option="`pkg-config --libs gstreamer-1.0 gstreamer-video-1.0`" />
					<Add option="`curl-config --libs`" />
					<Add option="-lexpat" />
					<Add option="-lporttime -lportmidi" />
					<Add option="-rdynamic" />
				</Linker>
			</Target>
			<Target title="Linux_Release">
				<Option platforms="Unix;" />
				<Option output="../../bin/RemoteFalcon" imp_lib="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).a" def_file="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).def" prefix_auto="1" extension_auto="1" />
				<Option object_output=".objs_lr" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-Wall" />
					<Add option="-fPIC" />
					<Add option="-std=gnu++20" />
					<Add option="`wx-config --version=3.3 --cflags`" />
					<Add option="`pkg-config --cflags gstreamer-1.0 gstreamer-video-1.0`" />
					<Add option="`pkg-config --cflags libavformat libavcodec libavutil  libswresample libswscale`" />
					<Add option="`curl-config --cflags`" />
					<Add option="-Winvalid-pch" />
					<Add option="-DWX_PRECOMP" />
					<Add option="-DLINUX" />
					<Add option="-DNDEBUG" />
					<Add option="-D__cdecl=&apos;&apos;" />
					<Add directory="include" />
					<Add directory="../xSchedule/RemoteFalcon" />
					<Add directory="../include" />
					<Add directory="../../xLights" />
					<Add directory="../../xlights/src-core" />
					<Add directory="../../xlights/src-core/utils" />
					<Add directory="../../xlights/src-core/render" />
					<Add directory="../../xlights/src-ui-wx" />
					<Add directory="../../xlights/src-ui-wx/shared/utils" />
					<Add directory="../../xlights/common" />
					<Add directory="../../xlights/include" />
					<Add directory="../../dependencies/pugixml/src" />
					<Add directory="../../dependencies/spdlog/include" />
				</Compiler>
				<Linker>
					<Add option="-lGL -lGLU -lglut -ldl -lX11 -lz -lzstd" />
					<Add option="`pkg-config --libs libavformat libavcodec libavutil  libswresample libswscale`" />
					<Add option="`sdl2-config --libs`" />
					<Add option="`wx-config --version=3.3 --libs std,media,gl,aui,propgrid`" />
					<Add option="`pkg-config --libs gstreamer-1.0 gstreamer-video-1.0`" />
					<Add option="`curl-config --libs`" />
					<Add option="-lexpat" />
					<Add option="-lporttime -lportmidi" />
					<Add option="-rdynamic" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-fno-strict-aliasing" />
			<Add option="-Wno-unused-local-typedefs" />
			<Add option="-DwxUSE_UNICODE" />
		</Compiler>
		<ResourceCompiler>
			<Add directory="$(#wx)/include" />
		</ResourceCompiler>
		<Unit filename="../../xlights/src-core/utils/AppCallbacks.cpp" />
		<Unit filename="../../xlights/src-core/utils/FileUtils.cpp" />
		<Unit filename="../../xlights/src-core/utils/Color.cpp" />
		<Unit filename="../../xlights/src-core/utils/string_utils.cpp" />
		<Unit filename="../../xlights/src-core/settings/XLightsSettings.cpp" />
		<Unit filename="../../xlights/src-ui-wx/settings/XLightsConfigAdapter.cpp" />
		<Unit filename="../../xlights/src-core/utils/ip_utils.cpp" />

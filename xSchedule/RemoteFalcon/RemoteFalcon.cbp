		<Unit filename="../../xlights/src-core/utils/ShowGuid.cpp" />
		<Unit filename="../../xlights/src-core/utils/JobPool.cpp" />
		<Unit filename="../../xlights/src-core/utils/TraceLog.cpp" />
		<Unit filename="../../xlights/common/xlBaseApp.cpp" />
		<Unit filename="../../xlights/common/xlBaseApp.h" />
		<Unit filename="../../xlights/common/xlStackWalker.h" />
		<Unit filename="../../xlights/src-core/utils/SpecialOptions.cpp" />
		<Unit filename="../../xlights/src-core/utils/SpecialOptions.h" />
		<Unit filename="../../dependencies/pugixml/src/pugixml.cpp" />
		<Unit filename="../../xlights/src-core/utils/UtilFunctions.cpp" />
		<Unit filename="../../xlights/src-core/utils/UtilFunctions.h" />
		<Unit filename="../../xlights/src-ui-wx/shared/utils/wxUtilities.cpp" />
		<Unit filename="../../xlights/src-ui-wx/shared/utils/wxUtilities.h" />
		<Unit filename="../../xlights/src-core/utils/CurlManager.cpp" />
		<Unit filename="../../xlights/src-core/utils/CurlManager.h" />
		<Unit filename="../../xlights/src-ui-wx/shared/utils/xLightsTimer.cpp" />
		<Unit filename="../../xlights/src-ui-wx/shared/utils/xLightsTimer.h" />
		<Unit filename="../../xlights/src-core/xLightsVersion.h" />
		<Unit filename="Bandwidth.h" />
		<Unit filename="RemoteFalconApp.cpp" />
		<Unit filename="RemoteFalconApp.h" />
		<Unit filename="RemoteFalconMain.cpp" />
		<Unit filename="RemoteFalconMain.h" />
		<Unit filename="RemoteFalconOptions.cpp" />
		<Unit filename="RemoteFalconOptions.h" />
		<Unit filename="RemoteFalconSettingsDialog.cpp" />
		<Unit filename="RemoteFalconSettingsDialog.h" />
		<Unit filename="xSchedule.h" />
		<Unit filename="RemoteFalcon.h" />
		<Unit filename="resource.rc">
			<Option compilerVar="WINDRES" />
			<Option target="MinGW_Debug" />
			<Option target="MinGW_Release" />
			<Option target="64bit_MinGW_Release" />
		</Unit>
		<Unit filename="wxsmith/RemoteFalconframe.wxs" />
		<Unit filename="wxsmith/RemoteFalconSettingsDialog.wxs" />
		<Extensions>
			<code_completion />
			<envvars />
			<debugger />
			<lib_finder disable_auto="1" />
			<wxsmith version="1">
				<gui name="wxWidgets" src="RemoteFalconApp.cpp" main="RemoteFalconFrame" init_handlers="necessary" language="CPP" />
				<resources>
					<wxFrame wxs="wxsmith/RemoteFalconframe.wxs" src="RemoteFalconMain.cpp" hdr="RemoteFalconMain.h" fwddecl="0" i18n="1" name="RemoteFalconFrame" language="CPP" />
					<wxDialog wxs="wxsmith/RemoteFalconSettingsDialog.wxs" src="RemoteFalconSettingsDialog.cpp" hdr="RemoteFalconSettingsDialog.h" fwddecl="0" i18n="1" name="RemoteFalconSettingsDialog" language="CPP" />
				</resources>
			</wxsmith>
		</Extensions>
	</Project>
</CodeBlocks_project_file>
